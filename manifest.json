{
  "manifest_version": 3,
  "name": "IOCulus",
  "version": "1.0.0",
  "description": "Reputation lookups for IPs, domains, URLs, and hashes, plus IOC extraction and network request inspection.",
  "author": "Mason Clemons",
  "permissions": [
    "contextMenus",
    "storage",
    "scripting",
    "webRequest",
    "sidePanel"
  ],
  "host_permissions": [
    "<all_urls>"
  ],
  "background": {
    "service_worker": "background.js"
  },
  "side_panel": {
    "default_path": "panel.html"
  },
  "action": {
    "default_title": "IOCulus",
    "default_icon": {
      "16": "icons/icon16.png",
      "32": "icons/icon32.png",
      "48": "icons/icon48.png",
      "128": "icons/icon128.png"
    }
  },
  "icons": {
    "16": "icons/icon16.png",
    "32": "icons/icon32.png",
    "48": "icons/icon48.png",
    "128": "icons/icon128.png"
  },
  "options_page": "settings.html"
}
